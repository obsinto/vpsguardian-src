[Unit]
Description=VPS Guardian - Monitor Preventivo (verificação)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Roda no HOST, fora do Docker, para funcionar mesmo se o Docker travar.
# O wrapper descobre INSTALL_ROOT em .install.conf, inclusive instalações legadas
# e caminhos customizados. Assim a unit não fixa /opt/vpsguardian.
ExecStart=/usr/local/bin/vps-guardian monitor check --quiet
# Baixo impacto no host
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
